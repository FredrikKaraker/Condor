---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Build-time imported images, in display order. */
  photos: ImageMetadata[];
}

const { photos } = Astro.props;

/**
 * Mosaic rhythm: most tiles are plain squares, with an occasional larger tile
 * to break the grid. Landscape shots get the wide slot, portraits the tall one,
 * so a crop never fights the photo it holds.
 */
type Tile = 'unit' | 'feature' | 'wide' | 'tall';

function tileFor(index: number, ratio: number, total: number): Tile {
  // A short gallery has no room to absorb a big tile — the leftovers read as
  // holes rather than as rhythm. Same near the end of any gallery, where a
  // spanning tile leaves the last row half empty.
  if (total < 12 || index >= total - 4) return 'unit';

  const beat = index % 11;
  if (beat === 0) return 'feature';
  if (beat === 4 && ratio > 1.2) return 'wide';
  if (beat === 7 && ratio < 0.95) return 'tall';
  return 'unit';
}

const spanClass: Record<Tile, string> = {
  unit: '',
  feature: 'sm:col-span-2 sm:row-span-2',
  wide: 'sm:col-span-2',
  tall: 'sm:row-span-2',
};

// A spanning tile is rendered at roughly twice the width of a unit tile.
const sizesFor: Record<Tile, string> = {
  unit: '(min-width: 1280px) 280px, (min-width: 640px) 33vw, 50vw',
  feature: '(min-width: 1280px) 570px, (min-width: 640px) 66vw, 50vw',
  wide: '(min-width: 1280px) 570px, (min-width: 640px) 66vw, 50vw',
  tall: '(min-width: 1280px) 280px, (min-width: 640px) 33vw, 50vw',
};

const tiles = photos.map((photo, i) => ({
  photo,
  tile: tileFor(i, photo.width / photo.height, photos.length),
}));

// Full-size variants for the lightbox, generated once at build time.
const fullSize = await Promise.all(
  photos.map((photo) =>
    getImage({
      src: photo,
      width: Math.min(photo.width, 1600),
      format: 'webp',
      quality: 78,
    }),
  ),
);

const lightboxPhotos = fullSize.map((img, i) => ({
  src: img.src,
  w: img.attributes.width ?? photos[i].width,
  h: img.attributes.height ?? photos[i].height,
}));
---

<section class="mb-10" aria-label="Tournament photos">
  <!-- No heading: the photos read as a continuation of the recap. The rule
       fades from both ends so it isn't anchored to a title that isn't there. -->
  <div class="h-px mb-8 bg-gradient-to-r from-transparent via-gold-800/40 to-transparent"></div>

  <!--
    Set the reveal flag before the grid is parsed: with JS the tiles start
    hidden and fade in on scroll, without it they simply render.
  -->
  <script is:inline>
    document.currentScript.nextElementSibling?.setAttribute('data-reveal', '');
  </script>
  <div class="photo-grid-wrap xl:-mx-32">
    <div class="photo-grid" data-gallery>
      {tiles.map(({ photo, tile }, i) => (
        <button
          type="button"
          class:list={[
            'photo-tile group relative overflow-hidden rounded-lg',
            'border border-gold-800/20 bg-green-900/30 cursor-zoom-in',
            'transition-[border-color,box-shadow] duration-300',
            'hover:border-gold-600/50 hover:shadow-[0_0_0_1px_rgba(197,165,90,0.15),0_12px_40px_-12px_rgba(0,0,0,0.8)]',
            'focus:outline-none focus-visible:border-gold-400 focus-visible:ring-2 focus-visible:ring-gold-500/40',
            spanClass[tile],
          ]}
          data-index={i}
          aria-label={`Open photo ${i + 1} of ${photos.length}`}
        >
          <Image
            src={photo}
            alt=""
            widths={[400, 800]}
            sizes={sizesFor[tile]}
            format="webp"
            quality={72}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
          <span
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-green-950/50 via-transparent to-transparent opacity-70 transition-opacity duration-300 group-hover:opacity-0"
          ></span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox -->
<div
  id="photo-lightbox"
  class="fixed inset-0 z-[60] hidden items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
>
  <div class="absolute inset-0 bg-green-950/96 backdrop-blur-sm" data-lb-dismiss></div>

  <figure class="relative flex h-full w-full flex-col items-center justify-center px-4 py-14 sm:px-16">
    <img
      data-lb-image
      alt=""
      class="max-h-[80vh] max-w-full rounded-md object-contain shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)]"
    />
    <figcaption class="mt-5 font-serif text-sm tracking-[0.25em] text-gold-500" data-lb-count></figcaption>
  </figure>

  <button
    type="button"
    data-lb-close
    class="absolute top-4 right-4 sm:top-6 sm:right-6 grid h-11 w-11 place-items-center rounded-full border border-gold-800/40 bg-green-900/60 text-gold-300 transition-colors hover:border-gold-500 hover:text-gold-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/50"
    aria-label="Close photo viewer"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
  </button>

  <button
    type="button"
    data-lb-prev
    class="absolute left-2 sm:left-5 top-1/2 -translate-y-1/2 grid h-11 w-11 place-items-center rounded-full border border-gold-800/40 bg-green-900/60 text-gold-300 transition-colors hover:border-gold-500 hover:text-gold-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/50"
    aria-label="Previous photo"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
  </button>

  <button
    type="button"
    data-lb-next
    class="absolute right-2 sm:right-5 top-1/2 -translate-y-1/2 grid h-11 w-11 place-items-center rounded-full border border-gold-800/40 bg-green-900/60 text-gold-300 transition-colors hover:border-gold-500 hover:text-gold-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/50"
    aria-label="Next photo"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
  </button>
</div>

<style>
  /*
   * Square grid cells, always. Row height is derived from the container width
   * rather than from the tiles themselves, so a row made up entirely of
   * spanning tiles still gets a real height instead of collapsing.
   */
  .photo-grid-wrap {
    container-type: inline-size;
  }

  .photo-grid {
    --gap: 0.5rem;
    --cols: 2;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));
    grid-auto-flow: dense;
    gap: var(--gap);
  }

  @media (min-width: 640px) {
    .photo-grid {
      --gap: 0.75rem;
      --cols: 3;
    }
  }

  @media (min-width: 1280px) {
    .photo-grid {
      --cols: 4;
    }
  }

  /* Scroll reveal — only armed when the inline script above ran. */
  [data-reveal] .photo-tile {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 600ms ease-out, transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms, box-shadow 300ms;
  }

  [data-reveal] .photo-tile.is-visible {
    opacity: 1;
    transform: none;
  }

  #photo-lightbox.is-open {
    display: flex;
  }

  #photo-lightbox [data-lb-image] {
    animation: lb-in 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] .photo-tile,
    [data-reveal] .photo-tile.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .photo-tile img {
      transition: none;
    }

    #photo-lightbox [data-lb-image] {
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ lightboxPhotos }}>
  (() => {
    const grid = document.querySelector('[data-gallery]');
    const lightbox = document.getElementById('photo-lightbox');
    if (!grid || !lightbox) return;

    const tiles = Array.from(grid.querySelectorAll('.photo-tile'));

    /* Staggered scroll reveal */
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const delay = (Number(entry.target.dataset.index) % 4) * 70;
            setTimeout(() => entry.target.classList.add('is-visible'), delay);
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      tiles.forEach((tile) => observer.observe(tile));
    } else {
      tiles.forEach((tile) => tile.classList.add('is-visible'));
    }

    /* Lightbox */
    const image = lightbox.querySelector('[data-lb-image]');
    const counter = lightbox.querySelector('[data-lb-count]');
    let current = 0;
    let lastFocused = null;

    const preload = (index) => {
      const photo = lightboxPhotos[index];
      if (photo) new Image().src = photo.src;
    };

    const show = (index) => {
      current = (index + lightboxPhotos.length) % lightboxPhotos.length;
      const photo = lightboxPhotos[current];
      image.src = photo.src;
      image.width = photo.w;
      image.height = photo.h;
      counter.textContent = `${current + 1} / ${lightboxPhotos.length}`;
      preload(current + 1);
      preload(current - 1 + lightboxPhotos.length);
    };

    const open = (index) => {
      lastFocused = document.activeElement;
      show(index);
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      lightbox.querySelector('[data-lb-close]').focus();
    };

    const close = () => {
      lightbox.classList.remove('is-open');
      document.body.style.overflow = '';
      image.removeAttribute('src');
      if (lastFocused) lastFocused.focus();
    };

    tiles.forEach((tile) => {
      tile.addEventListener('click', () => open(Number(tile.dataset.index)));
    });

    lightbox.querySelector('[data-lb-close]').addEventListener('click', close);
    lightbox.querySelector('[data-lb-dismiss]').addEventListener('click', close);
    lightbox.querySelector('[data-lb-prev]').addEventListener('click', () => show(current - 1));
    lightbox.querySelector('[data-lb-next]').addEventListener('click', () => show(current + 1));

    document.addEventListener('keydown', (event) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') show(current - 1);
      else if (event.key === 'ArrowRight') show(current + 1);
    });

    /* Swipe */
    let touchStartX = null;
    lightbox.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0].clientX;
      },
      { passive: true },
    );
    lightbox.addEventListener(
      'touchend',
      (event) => {
        if (touchStartX === null) return;
        const delta = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(delta) > 50) show(current + (delta < 0 ? 1 : -1));
        touchStartX = null;
      },
      { passive: true },
    );
  })();
</script>
