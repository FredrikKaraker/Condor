---
import Layout from '../layouts/Layout.astro';
import data from '../data/tournaments.json';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const upcoming = data.upcoming;

// Shown when there's no upcoming tournament to announce yet. Everything but the
// photo is read off the referenced tournament, so scores only live in one place.
const champion = data.champion;
const championEvent = champion
  ? data.tournaments.find((t) => t.slug === champion.slug)
  : undefined;
const championResult = championEvent?.results[0];
const podium = championEvent?.results.slice(1, 3) ?? [];

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/photos/**/*.{jpg,jpeg,png}',
  { eager: true },
);
const championPhoto = champion
  ? photoModules[`/src/photos/${champion.slug}/${champion.photo}`]?.default
  : undefined;

const avatars: Record<string, string> = {
  'Fredrik Karåker': 'fredrik',
  'Rasmus Gustafson': 'rasmus',
  'Johan Bäckström': 'johan',
  'Erik Larsson': 'erik',
  'Anthony Smith': 'anthony',
  'Carl Beling': 'carl',
  'Axel Philipson': 'axel',
  'Sebastian Ahlström': 'sebastian',
  'Mikael Bäckman': 'micke',
  'Oscar Rosander': 'oscar',
  'David Wasserman': 'david',
};

const firstName = (name: string) => name.split(' ')[0];
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-green-900/50 to-green-950"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40 text-center">
      <div class="mb-8">
        <img src={`${base}/logo.png`} alt="Condor Gilligan Invitational" class="w-40 h-40 sm:w-48 sm:h-48 mx-auto drop-shadow-lg" />
      </div>
      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-tight">
        Condor Gilligan<br />
        <span class="text-gold-400">Invitational</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Where tradition meets competition. An annual gathering of golfers united by a shared love of the game and their mediocre performance.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}/participants/`}
          class="inline-block bg-gold-500 hover:bg-gold-400 text-green-950 font-semibold px-8 py-3 rounded transition-colors text-sm tracking-wide uppercase"
        >
          View Participants
        </a>
        <a
          href={`${base}/rules/`}
          class="inline-block border border-gold-600/50 hover:border-gold-500 text-gold-400 font-semibold px-8 py-3 rounded transition-colors text-sm tracking-wide uppercase"
        >
          Tournament Rules
        </a>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-px bg-gradient-to-r from-transparent via-gold-700/40 to-transparent"></div>
  </div>

  <!-- Info Cards -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-green-900/30 border border-gold-800/20 rounded-lg p-8 text-center">
        <div class="text-gold-400 text-3xl mb-4 font-serif">&#9971;</div>
        <h3 class="font-serif text-xl text-gold-300 mb-3">The Game</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          A timeless pursuit across green expanses. Equal parts patience, persistence, and the occasional moment of magic that keeps us coming back.
        </p>
      </div>
      <div class="bg-green-900/30 border border-gold-800/20 rounded-lg p-8 text-center">
        <div class="text-gold-400 text-3xl mb-4 font-serif">&#127942;</div>
        <h3 class="font-serif text-xl text-gold-300 mb-3">The Competition</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          A format designed to challenge and entertain. Check the rules page for full tournament details.
        </p>
      </div>
      <div class="bg-green-900/30 border border-gold-800/20 rounded-lg p-8 text-center">
        <div class="text-gold-400 text-3xl mb-4 font-serif">&#127867;</div>
        <h3 class="font-serif text-xl text-gold-300 mb-3">The Social</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          More than just golf. The CGI is about friendships, stories, and memorable moments on and off the course.
        </p>
      </div>
    </div>
  </section>

  <!-- Next Tournament -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    {upcoming ? (
      <div class="bg-gradient-to-br from-green-900/50 to-green-800/30 border border-gold-700/30 rounded-xl p-8 sm:p-12">
        <div class="text-center">
          <span class="text-gold-600 text-sm font-medium tracking-[0.2em] uppercase">Next Tournament</span>
          <h2 class="font-serif text-3xl sm:text-4xl text-white mt-4">{upcoming.title}</h2>
          <p class="text-gold-400 mt-2 text-sm sm:text-base tracking-wide">{upcoming.dates}</p>
          <p class="text-gray-500 mt-2 text-sm">{upcoming.courses.join(' · ')}</p>
        </div>

        <div class="h-px bg-gold-800/30 my-8 max-w-md mx-auto"></div>

        <div class="text-center max-w-2xl mx-auto">
          <h3 class="font-serif text-xl sm:text-2xl text-gold-300 mb-3">{upcoming.teaserHeading}</h3>
          <p class="text-gray-300 leading-relaxed">{upcoming.teaserBody}</p>
        </div>

        <div class="mt-10">
          <p class="text-center text-gold-600 text-xs font-medium tracking-[0.2em] uppercase mb-6">Confirmed Field</p>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-5">
            {upcoming.participants.map((name) => (
              <div class="flex flex-col items-center w-16">
                <img
                  src={`${base}/avatars/sm/${avatars[name]}.png`}
                  alt={name}
                  class="w-14 h-14 rounded-full object-cover border-2 border-gold-700/40"
                />
                <p class="text-gray-300 text-xs mt-2 text-center">{firstName(name)}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    ) : championEvent && championResult ? (
      <div class="bg-gradient-to-br from-green-900/50 to-green-800/30 border border-gold-700/30 rounded-xl p-8 sm:p-12">
        <div class="grid gap-8 sm:gap-12 md:grid-cols-[300px_minmax(0,1fr)] md:items-center max-w-3xl mx-auto">
          {championPhoto && (
            <Image
              src={championPhoto}
              alt={championResult.player}
              widths={[300, 600]}
              sizes="(min-width: 768px) 300px, 100vw"
              format="webp"
              quality={78}
              class="w-full max-w-xs mx-auto md:max-w-none rounded-xl border border-gold-700/30 object-cover aspect-[3/4] shadow-[0_20px_50px_-20px_rgba(0,0,0,0.9)]"
            />
          )}

          <div class="text-center md:text-left">
            <span class="text-gold-600 text-sm font-medium tracking-[0.2em] uppercase">
              {championEvent.year} Champion
            </span>
            <h2 class="font-serif text-4xl sm:text-5xl text-gold-400 font-bold mt-3">
              {championResult.player}
            </h2>
            {championResult.points != null && (
              <p class="text-gray-300 mt-2 text-lg">{championResult.points} points</p>
            )}

            <div class="h-px bg-gold-800/30 my-6 md:mx-0 mx-auto max-w-xs md:max-w-none"></div>

            <p class="text-white">{championEvent.title}</p>
            <p class="text-gold-400 mt-1 text-sm tracking-wide">{championEvent.dates}</p>
            <p class="text-gray-500 mt-1 text-sm">{championEvent.courses.join(' · ')}</p>

            {podium.length > 0 && (
              <p class="text-gray-400 text-sm mt-4">
                {podium.map((r, i) => (
                  <span>
                    {i > 0 && <span class="text-gold-800 mx-2">·</span>}
                    <span class="text-gold-600">{i === 0 ? '2nd' : '3rd'}</span>{' '}
                    {firstName(r.player)}
                  </span>
                ))}
              </p>
            )}

            <a
              href={`${base}/history/${championEvent.slug}/`}
              class="inline-flex items-center gap-1 text-gold-500 hover:text-gold-300 text-sm mt-6 transition-colors"
            >
              View the tournament &rarr;
            </a>
          </div>
        </div>
      </div>
    ) : (
      <div class="bg-gradient-to-br from-green-900/50 to-green-800/30 border border-gold-700/30 rounded-xl p-10 sm:p-14 text-center">
        <span class="text-gold-600 text-sm font-medium tracking-[0.2em] uppercase">Next Tournament</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-white mt-4 mb-4">Coming Soon</h2>
        <p class="text-gray-400 max-w-lg mx-auto">
          The next edition of the Condor Gilligan Invitational is being planned. Details will be announced here.
        </p>
      </div>
    )}
  </section>
</Layout>
